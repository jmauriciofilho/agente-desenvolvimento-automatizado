{
  "permissions": {
    "allow": [
      "Bash(.agent/scripts/verify.sh:*)",
      "Bash(.agent/scripts/check-scope.sh:*)",
      "Bash(.agent/scripts/status.sh:*)"
    ],
    "ask": [
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.gitignore)"
    ],
    "deny": [
      "Edit(./node_modules/**)",
      "Edit(./vendor/**)",
      "Edit(./.venv/**)",
      "Edit(./venv/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agent/scripts/status.sh --brief"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agent/scripts/hooks/guard-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agent/scripts/hooks/require-verify.sh"
          }
        ]
      }
    ]
  }
}
